[Unit]
Description=Check and deploy Xboard master from the owned GitHub fork
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/xboard-auto-deploy --poll
TimeoutStartSec=90min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

